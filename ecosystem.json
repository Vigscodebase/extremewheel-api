{
    "apps": [
        {
            "name": "extremewheel-api",
            "script": "./server.js",
            "instances": "max",
            "exec_mode": "cluster",
            "watch": false,
            "max_memory_restart": "800M",
            "env_production": {
                "NODE_ENV": "production",
                "PORT": 5000
            }
        },
        {
            "name": "extremewheel-app-guide-worker",
            "script": "./workers/appGuideWorker.js",
            "instances": 1,
            "exec_mode": "fork",
            "watch": false,
            "max_memory_restart": "500M",
            "env_production": {
                "NODE_ENV": "production"
            }
        }
    ]
}