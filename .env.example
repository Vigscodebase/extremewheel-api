PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb://127.0.0.1:27017/extremewheel
DB_MAX_POOL_SIZE=50
DB_SERVER_SELECTION_TIMEOUT_MS=5000

# RSA keypair used to sign/verify JWTs (see generate-keys.js)
JWT_PRIVATE_KEY_PATH=/etc/extremewheel-secrets/private.pem
JWT_PUBLIC_KEY_PATH=/etc/extremewheel-secrets/public.pem
JWT_EXPIRES_IN=10m
JWT_RENEW_THRESHOLD_SECONDS=300

# Auth rate limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30

# General API rate limiting
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300

# Allowed browser origins for CORS, comma separated (leave blank for same-origin only)
CORS_ORIGINS=

# Plus-size recommendation engine tolerances (percent, as decimals) — the
# server is the single source of truth for this business rule; the search
# response echoes back whatever is configured here so the client never has
# to hardcode/duplicate it.
PLUS_SIZE_HEIGHT_TOLERANCE_PCT=0.03
PLUS_SIZE_TREAD_TOLERANCE_PCT=0.15

# Redis (sessions/cache + BullMQ job queue backend)
REDIS_URL=redis://127.0.0.1:6379

# One-time admin bootstrap account (utils/seedAdmin.js). Change the password
# immediately after first login; this is only read by the seed script.
ADMIN_SEED_EMAIL=admin@clickmatix.com
ADMIN_SEED_PASSWORD=change-me-now